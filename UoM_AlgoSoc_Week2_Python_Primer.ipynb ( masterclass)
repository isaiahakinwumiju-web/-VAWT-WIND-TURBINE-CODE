      "source": [
        "# Worked example: a loop that prints each daily return.\n",
        "prices = [100, 101, 99.99, 102.01]\n",
        "for i in range(1, len(prices)):\n",
        "    r = prices[i] / prices[i - 1] - 1\n",
        "    if r > 0:\n",
        "        print(f\"Day {i}: {r:.4f}, up\")\n",
        "    elif r < 0:\n",
        "        print(f\"Day {i}: {r:.4f}, down\")\n",
        "    else:\n",
        "        print(f\"Day {i}: {r:.4f}, flat\")"
      ]
    },
